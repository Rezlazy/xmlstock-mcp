{
  "name": "@rezlazy/xmlstock-mcp",
  "version": "0.1.0",
  "description": "MCP server for XMLstock (Yandex XML, Yandex Live, Google XML Search, Wordstat)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "xmlstock-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node' && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pack": "npm run build && mkdir -p dist-packages && npm pack --pack-destination dist-packages"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Rezlazy",
  "keywords": [
    "mcp",
    "xmlstock",
    "yandex",
    "google",
    "wordstat",
    "seo",
    "model-context-protocol"
  ]
}
